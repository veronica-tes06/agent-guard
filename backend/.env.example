# Template for the backend's settings. Copy it to backend/.env (cp .env.example .env).
# .env is not committed to Git, as real settings can contain passwords.
# Restart uvicorn after changing .env; it's only read when the app starts.

# Where the database is, in the format:
#   dialect+driver://user:password@host:port/database
# Port 3307 matches the port published in docker-compose.yml.
DATABASE_URL=mysql+pymysql://agentguard:agentguard@localhost:3307/agentguard
